,"window":[-8,8,-0.5,16],"consts":[{"name":"C","min":-3,"max":3,"value":1.5707963267948966,"sweep":true,"n":13,"spacing":"uniform","step":0.03},{"name":"k","min":0,"max":10,"value":7,"sweep":true,"n":11,"spacing":"uniform","step":1,"integer":true,"label":"rama k"}],"y":"atan(atan(x)+C)/2+k*pi/2","slope":"cos(2*y)^2/(2*(1+x^2))","extras":[{"kind":"explicit","y":"pi/4+0*pi/2","label":"cos 2y=0"},{"kind":"explicit","y":"pi/4+1*pi/2","label":null},{"kind":"explicit","y":"pi/4+2*pi/2","label":null},{"kind":"explicit","y":"pi/4+3*pi/2","label":null},{"kind":"explicit","y":"pi/4+4*pi/2","label":null},{"kind":"explicit","y":"pi/4+5*pi/2","label":null},{"kind":"explicit","y":"pi/4+6*pi/2","label":null},{"kind":"explicit","y":"pi/4+7*pi/2","label":null},{"kind":"explicit","y":"pi/4+8*pi/2","label":null},{"kind":"explicit","y":"pi/4+9*pi/2","label":null}],"particular":{"values":{"C":1.5707963267948966,"k":7},"label":"y→7π/2 (x→−∞)"}},"h1-14":{"id":"h1-14","sheet":1,"num":14,"kind":"explicit","tex":"y=\\pm Ke^{x^2}-\\pi","window":[-2,2,-9,4],"consts":[{"name":"K","min":-2,"max":2,"value":0.4,"sweep":true,"n":13,"spacing":"uniform","step":0.02}],"y":"K*exp(x^2)-pi","slope":"2*x*(pi+y)","particular":{"values":{"K":0},"label":"y acotada: K=0"}},"h1-15":{"id":"h1-15","sheet":1,"num":15,"kind":"explicit","tex":"\\tan\\frac{y}{x}=\\ln|x|+C","window":[-6,6,-10,10],"consts":[{"name":"C","min":-3,"max":3,"value":0,"sweep":true,"n":13,"spacing":"uniform","step":0.03},{"name":"k","min":-2,"max":2,"value":0,"sweep":true,"n":5,"spacing":"uniform","step":1,"integer":true,"label":"rama k"}],"y":"x*(atan(log(abs(x))+C)+k*pi)","slope":"y/x+cos(y/x)^2","extras":[{"kind":"explicit","y":"x*(pi/2+(-2)*pi)","label":null},{"kind":"explicit","y":"x*(pi/2+(-1)*pi)","label":null},{"kind":"explicit","y":"x*(pi/2+(0)*pi)","label":"y=x(π/2+kπ)"},{"kind":"explicit","y":"x*(pi/2+(1)*pi)","label":null}]},"h1-16":{"id":"h1-16","sheet":1,"num":16,"kind":"explicit","tex":"y=xe^{1+Kx}","window":[0,5,0,8],"consts"