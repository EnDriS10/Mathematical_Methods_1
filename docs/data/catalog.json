{"h1-01":{"id":"h1-01","sheet":1,"num":1,"kind":"level","tex":"\\arctan x+\\arctan y=C","window":[-6,6,-6,6],"consts":[{"name":"C","min":-3,"max":3,"value":0.8,"sweep":true,"n":13,"spacing":"uniform","step":0.03,"role":"level"}],"F":"atan(x)+atan(y)","slope":"-(1+y^2)/(1+x^2)","analytic":[{"kind":"explicit","y":"tan(C-atan(x))","valid":"pi/2-abs(C-atan(x))"}]},"h1-02":{"id":"h1-02","sheet":1,"num":2,"kind":"level","tex":"x^2(1+y^2)=K,\\;K\\geq 0","window":[-4,4,-4,4],"consts":[{"name":"K","min":0.1,"max":6,"value":2,"sweep":true,"n":13,"spacing":"uniform","step":0.0295,"role":"level"}],"F":"x^2*(1+y^2)","slope":"-(1+y^2)/(x*y)","extras":[{"kind":"vline","x":"0","label":"K=0: x=0"}],"analytic":[{"kind":"param","x":"sqrt(K/(1+t^2))","y":"t","var":"t","t":[[-7,7]]},{"kind":"param","x":"-sqrt(K/(1+t^2))","y":"t","var":"t","t":[[-7,7]]}]},"h1-03":{"id":"h1-03","sheet":1,"num":3,"kind":"explicit","tex":"y=K\\sin x","window":[-7,7,-3.5,3.5],"consts":[{"name":"K","min":-3,"max":3,"value":1,"sweep":true,"n":13,"spacing":"uniform","step":0.03}],"y":"K*sin(x)","slope":"y*cos(x)/sin(x)","ode":"y1*sin(x)-y*cos(x)","particular":{"values":{"K":1},"point":["pi/2","1"],"label":"y(π/2)=1"}},"h1-04":{"id":"h1-04","sheet":1,"num":4,"kind":"level","tex":"\\sqrt{1+x^2}+\\sqrt{1+y^2}=C,\\;C\\geq 2","window":[-5,5,-5,5],"consts":[{"name":"C","min":2,"max":7,"value":4,"sweep":true,"n":13,"spacing":"uniform","step":0.025,"role":"level"}],"F":"sqrt(1+x^2)+sqrt(1+y^2)","slope":"-x*sqrt(1+y^2)/(y*sqrt(1+x^2))","analytic":[{"kind":"explicit","y":["sqrt((C-sqrt(1+x^2))^2-1)","-sqrt((C-sqrt(1+x^2))^2-1)"],"valid":"C-sqrt(1+x^2)-1"}]},"h1-05":{"id":"h1-05","sheet":1,"num":5,"kind":"explicit","tex":"\\sqrt{1-x^2}+\\sqrt{1-y^2}=C","window":[-1.2,1.2,-1.2,1.2],"consts":[{"name":"C","min":0.05,"max":2,"value":1,"sweep":true,"n":13,"spacing":"uniform","step":0.0097}],"y":["sqrt(1-(C-sqrt(1-x^2))^2)","-sqrt(1-(C-sqrt(1-x^2))^2)"],"valid":"C-sqrt(1-x^2)","slope":"-x*sqrt(1-y^2)/(y*sqrt(1-x^2))","aspect":"equal","particular":{"values":{"C":1},"point":["0","1"],"label":"y(0)=1"}},"h1-06":{"id":"h1-06","sheet":1,"num":6,"kind":"level","tex":"1-e^{-y}=\\pm Ke^{x}","window":[-4,3,-4,4],"consts":[{"name":"C","min":-3,"max":3,"value":1,"sweep":true,"n":13,"spacing":"uniform","step":0.03,"role":"level"}],"F":"(1-exp(-y))/exp(x)","slope":"exp(y)-1","analytic":[{"kind":"explicit","y":"-log(1-C*exp(x))"}]},"h1-07":{"id":"h1-07","sheet":1,"num":7,"kind":"level","tex":"x\\ln y=K","window":[-4,4,0.02,5],"consts":[{"name":"C","min":-3,"max":3,"value":1,"sweep":true,"n":13,"spacing":"uniform","step":0.03,"role":"level"}],"F":"x*log(y)","slope":"-y*log(y)/x","particular":{"curve":{"kind":"explicit","y":"1","label":null},"point":["1","1"],"label":"y(1)=1"},"analytic":[{"kind":"explicit","y":"exp(C/x)"}]},"h1-08":{"id":"h1-08","sheet":1,"num":8,"kind":"level","tex":"a^x+a^{-y}=K,\\;K>0","window":[-4,4,-4,4],"consts":[{"name":"K","min":0.2,"max":8,"value":3,"sweep":true,"n":12,"spacing":"uniform","step":0.039,"role":"level"},{"name":"a","min":0.2,"max":4,"value":2,"sweep":false,"n":13,"spacing":"uniform","step":0.05}],"F":"a^x+a^(-y)","slope":"a^(x+y)","analytic":[{"kind":"explicit","y":"-log(K-a^x)/log(a)"}]},"h1-09":{"id":"h1-09","sheet":1,"num":9,"kind":"level","tex":"\\dfrac{2}{1-\\tan\\frac{x-y}{2}}=x+C","window":[-7,7,-7,7],"consts":[{"name":"C","min":-8,"max":8,"value":0,"sweep":true,"n":13,"spacing":"uniform","step":0.08,"role":"level"}],"F":"2/(1-tan((x-y)/2))-x","slope":"sin(x-y)","extras":[{"kind":"explicit","y":"x-pi/2-2*pi*(-2)","label":null},{"kind":"explicit","y":"x-pi/2-2*pi*(-1)","label":null},{"kind":"explicit","y":"x-pi/2-2*pi*(0)","label":"y=x−π/2−2kπ"},{"kind":"explicit","y":"x-pi/2-2*pi*(1)","label":null},{"kind":"explicit","y":"x-pi/2-2*pi*(2)","label":null}],"analytic":[{"kind":"explicit","y":"x-2*atan(1-2/(x+C))-2*pi*(-3)-2*pi*sel(x+C,1,0)"},{"kind":"explicit","y":"x-2*atan(1-2/(x+C))-2*pi*(-2)-2*pi*sel(x+C,1,0)"},{"kind":"explicit","y":"x-2*atan(1-2/(x+C))-2*p